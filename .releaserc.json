{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "semantic-release-gitmoji",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": true }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/\"version\": \"[^\"]*\"/\"version\": \"${nextRelease.version}\"/' plantao365.plugin.json && npm run build && npx plantao-plugin sign emergency-contacts-${nextRelease.version}.p365 --key \"$RUNNER_TEMP/plugin-signing.pem\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json", "package-lock.json", "plantao365.plugin.json"],
        "message": "🔖 chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    ["@semantic-release/github", { "assets": [{ "path": "*.p365" }, { "path": "*.p365.sig" }] }]
  ]
}
